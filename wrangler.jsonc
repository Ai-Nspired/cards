{
  "name": "cards",
  "main": "worker.js",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2025-07-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/chat"]
  },
  "kv_namespaces": [
    {
      "binding": "kv",
      "id": "YOUR_KV_NAMESPACE_ID"
    }
  ],
  "routes": [
    { "pattern": "ai.nspired.cc", "custom_domain": true }
  ]
}
